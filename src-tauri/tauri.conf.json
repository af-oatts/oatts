{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "OATTS",
  "version": "1.0.0",
  "identifier": "com.oatts-authors.oatts",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
